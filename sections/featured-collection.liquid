{% assign collection = collections[section.settings.collection] %}
<section class="section">
  <div class="page-width">
    <div class="section-heading">
      <h2>{{ section.settings.heading }}</h2>
      <a class="button button--secondary" href="{{ collection.url | default: '/collections/all' }}">View all</a>
    </div>
    <div class="product-grid">
      {% for product in collection.products limit: section.settings.products_to_show %}
        {% render 'card-product', product: product %}
      {% else %}
        {% for product in collections.all.products limit: section.settings.products_to_show %}
          {% render 'card-product', product: product %}
        {% endfor %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Latest finds" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "min": 4, "max": 12, "step": 4, "label": "Products to show", "default": 8 }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
