<section class="section about-page">
  <div class="page-width">
    <div class="about-page__hero">
      <div class="about-page__intro">
        <p class="page-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        <h1>{{ section.settings.heading | default: page.title | escape }}</h1>
        <p>{{ section.settings.intro | escape }}</p>
      </div>
      <figure class="about-page__portrait">
        <div class="about-page__media">
          {% if section.settings.image != blank %}
            {{ section.settings.image | image_url: width: 1000 | image_tag: loading: 'eager', alt: section.settings.image.alt }}
          {% else %}
            <img src="{{ 'molly-portrait.jpg' | asset_url }}" alt="{{ 'about.page.portrait_alt' | t }}" width="1440" height="1920" loading="eager">
          {% endif %}
        </div>
        <figcaption>{{ 'about.page.portrait_caption' | t }}</figcaption>
      </figure>
    </div>

    <div class="about-page__story">
      <div class="about-page__story-heading">
        <p class="page-hero__eyebrow">{{ 'about.page.approach' | t }}</p>
        <h2>{{ section.settings.story_heading | escape }}</h2>
      </div>
      <div class="about-page__content">
        {% if page.content != blank %}
          <div class="rte">{{ page.content }}</div>
        {% else %}
          <p>{{ section.settings.story_text | escape }}</p>
        {% endif %}
      </div>
    </div>

    <div class="about-values">
      <article>
        <h3>{{ 'about.page.preloved_heading' | t }}</h3>
        <p>{{ 'about.page.preloved_text' | t }}</p>
      </article>
      <article>
        <h3>{{ 'about.page.selection_heading' | t }}</h3>
        <p>{{ 'about.page.selection_text' | t }}</p>
      </article>
      <article>
        <h3>{{ 'about.page.condition_heading' | t }}</h3>
        <p>{{ 'about.page.condition_text' | t }}</p>
      </article>
    </div>

    <div class="about-page__cta">
      <div>
        <h2>{{ section.settings.cta_heading | escape }}</h2>
        <p>{{ section.settings.cta_text | escape }}</p>
      </div>
      <a class="button" href="{{ routes.collections_url }}/shop-all-vintage">{{ section.settings.button_label | escape }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About page",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "About Molly's Retro Revival" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Vintage finds, chosen with care" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "An Adelaide vintage store with a considered collection of pre-loved furniture, glassware and homewares. Distinctive pieces for everyday living." },
    { "type": "image_picker", "id": "image", "label": "Story image" },
    { "type": "text", "id": "story_heading", "label": "Story heading", "default": "A thoughtful way to shop vintage" },
    { "type": "textarea", "id": "story_text", "label": "Fallback story text", "default": "Molly's Retro Revival is built around warm, character-filled pieces with a second life ahead of them. We source furniture, glassware, decor and small gifts for homes that feel personal, playful and a little nostalgic." },
    { "type": "text", "id": "cta_heading", "label": "CTA heading", "default": "Find a piece for your home" },
    { "type": "textarea", "id": "cta_text", "label": "CTA text", "default": "Explore the furniture, glassware and decorative pieces in our current collection." },
    { "type": "text", "id": "button_label", "label": "CTA button label", "default": "Explore the collection" }
  ]
}
{% endschema %}
