<section class="page-width collection-layout">
  <div>
    <h1 class="collection-title">{{ collection.title }}</h1>
    {% if collection.description != blank %}
      <div class="rte">{{ collection.description }}</div>
    {% endif %}
  </div>
  <form class="collection-filters" method="get" data-auto-submit>
    <div class="collection-filters__top">
      <span class="collection-filters__label">Filter by:</span>
      {% if collection.filters.size > 0 %}
        <div class="collection-filters__groups">
          {% for filter in collection.filters %}
            <details class="filter-group">
              <summary>
                <span>{{ filter.label }}</span>
                {% if filter.active_values.size > 0 %}
                  <small>{{ filter.active_values.size }}</small>
                {% endif %}
              </summary>

              {% case filter.type %}
                {% when 'price_range' %}
                  <div class="filter-price">
                    <label>
                      <span>Min</span>
                      <input
                        name="{{ filter.min_value.param_name }}"
                        type="number"
                        min="0"
                        {% if filter.min_value.value %}value="{{ filter.min_value.value | divided_by: 100 }}"{% endif %}
                        placeholder="0"
                      >
                    </label>
                    <label>
                      <span>Max</span>
                      <input
                        name="{{ filter.max_value.param_name }}"
                        type="number"
                        min="0"
                        {% if filter.max_value.value %}value="{{ filter.max_value.value | divided_by: 100 }}"{% endif %}
                        placeholder="{{ filter.range_max | divided_by: 100 }}"
                      >
                    </label>
                  </div>
                {% else %}
                  <ul class="filter-options">
                    {% for value in filter.values %}
                      <li>
                        <label class="{% if value.count == 0 and value.active == false %}is-disabled{% endif %}">
                          <input
                            type="checkbox"
                            name="{{ value.param_name }}"
                            value="{{ value.value }}"
                            {% if value.active %}checked{% endif %}
                            {% if value.count == 0 and value.active == false %}disabled{% endif %}
                          >
                          <span>{{ value.label }}</span>
                          <small>{{ value.count }}</small>
                        </label>
                      </li>
                    {% endfor %}
                  </ul>
              {% endcase %}
            </details>
          {% endfor %}
        </div>
      {% endif %}
      <div class="collection-sort">
        <label for="SortBy">Sort</label>
        <select id="SortBy" name="sort_by">
          {% assign sort_by = collection.sort_by | default: collection.default_sort_by %}
          {% for option in collection.sort_options %}
            <option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name }}</option>
          {% endfor %}
        </select>
      </div>
    </div>

    {% assign has_active_filters = false %}
    {% for filter in collection.filters %}
      {% if filter.active_values.size > 0 %}
        {% assign has_active_filters = true %}
      {% endif %}
      {% if filter.type == 'price_range' %}
        {% if filter.min_value.value or filter.max_value.value %}
          {% assign has_active_filters = true %}
        {% endif %}
      {% endif %}
    {% endfor %}

    {% if has_active_filters %}
      <div class="active-filters" aria-label="Active filters">
        {% for filter in collection.filters %}
          {% for value in filter.active_values %}
            <a href="{{ value.url_to_remove }}">{{ value.label }} ×</a>
          {% endfor %}
          {% if filter.type == 'price_range' %}
            {% if filter.min_value.value or filter.max_value.value %}
              <a href="{{ filter.url_to_remove }}">
                {% if filter.min_value.value %}{{ filter.min_value.value | money }}{% else %}{{ 0 | money }}{% endif %}
                –
                {% if filter.max_value.value %}{{ filter.max_value.value | money }}{% else %}{{ filter.range_max | money }}{% endif %}
                ×
              </a>
            {% endif %}
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </form>
  {% paginate collection.products by 24 %}
    <div class="product-grid">
      {% for product in collection.products %}
        {% render 'card-product', product: product %}
      {% endfor %}
    </div>
    {% if paginate.pages > 1 %}
      <nav class="pagination" role="navigation">{{ paginate | default_pagination }}</nav>
    {% endif %}
  {% endpaginate %}
</section>

{% schema %}
{
  "name": "Collection product grid",
  "settings": []
}
{% endschema %}

{% javascript %}
  (() => {
    const submitFilterForm = (form) => {
      const url = new URL(form.action || window.location.href, window.location.origin);
      const params = new URLSearchParams(new FormData(form));

      Array.from(params.entries()).forEach(([key, value]) => {
        if (value === '') {
          params.delete(key);
        }
      });

      const query = params.toString();
      window.location.href = query ? `${url.pathname}?${query}` : url.pathname;
    };

    document.querySelectorAll('[data-auto-submit]').forEach((form) => {
      form.dataset.dirty = 'false';

      form.querySelectorAll('.filter-group').forEach((details) => {
        details.addEventListener('toggle', () => {
          if (!details.open) return;

          if (form.dataset.dirty === 'true') {
            submitFilterForm(form);
            return;
          }

          form.querySelectorAll('.filter-group[open]').forEach((openDetails) => {
            if (openDetails !== details) {
              openDetails.removeAttribute('open');
            }
          });
        });
      });

      form.addEventListener('change', (event) => {
        if (event.target.matches('select')) {
          submitFilterForm(form);
          return;
        }

        if (event.target.matches('input')) {
          form.dataset.dirty = 'true';
        }
      });

      form.addEventListener('keydown', (event) => {
        if (event.key !== 'Enter') return;
        if (!event.target.matches('input, select, summary')) return;

        event.preventDefault();
        form.querySelectorAll('.filter-group[open]').forEach((details) => {
          details.removeAttribute('open');
        });
        submitFilterForm(form);
      });
    });

    document.addEventListener('click', (event) => {
      document.querySelectorAll('[data-auto-submit]').forEach((form) => {
        if (form.contains(event.target)) return;

        form.querySelectorAll('.filter-group[open]').forEach((details) => {
          details.removeAttribute('open');
        });

        if (form.dataset.dirty === 'true') {
          submitFilterForm(form);
        }
      });
    });
  })();
{% endjavascript %}
