<section class="section blog-index">
  <div class="page-width">
    <div class="page-hero page-hero--blog">
      <p class="page-hero__eyebrow">Blog</p>
      <h1>Molly's Journal</h1>
      <p>Styling notes, care tips, sourcing stories, and small ideas for living with vintage pieces.</p>
    </div>

    {% paginate blog.articles by 9 %}
      <div class="article-grid">
        {% for article in blog.articles %}
          <article class="article-card">
            <a href="{{ article.url }}">
              <div class="article-card__media">
                {% if article.image %}
                  {{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: article.image.alt | escape }}
                {% else %}
                  <img class="image-placeholder" src="{{ 'retro-placeholder.svg' | asset_url }}" alt="" width="1200" height="900" loading="lazy">
                {% endif %}
              </div>
              <div class="article-card__content">
                <p>{{ article.published_at | date: '%d %b %Y' }}</p>
                <h2>{{ article.title }}</h2>
                {% if article.excerpt != blank %}
                  <div>{{ article.excerpt | strip_html | truncate: 150 }}</div>
                {% else %}
                  <div>{{ article.content | strip_html | truncate: 150 }}</div>
                {% endif %}
              </div>
            </a>
          </article>
        {% else %}
          <article class="article-card">
            <a href="/blogs/news/how-to-style-one-great-vintage-piece-in-a-modern-room">
              <div class="article-card__media">
                <img class="image-placeholder" src="{{ 'retro-placeholder.svg' | asset_url }}" alt="" width="1200" height="900" loading="lazy">
              </div>
              <div class="article-card__content">
                <p>Coming soon</p>
                <h2>How to style one great vintage piece</h2>
                <div>Start with one warm anchor piece, repeat its colour once or twice, then let texture do the heavy lifting.</div>
              </div>
            </a>
          </article>
        {% endfor %}
      </div>

      {% if paginate.pages > 1 %}
        <nav class="pagination" role="navigation">{{ paginate | default_pagination }}</nav>
      {% endif %}
    {% endpaginate %}
  </div>
</section>

{% schema %}
{
  "name": "Main blog",
  "settings": []
}
{% endschema %}
