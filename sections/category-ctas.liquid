<section class="section">
  <div class="page-width">
    <div class="section-heading">
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="category-grid">
      {% for block in section.blocks %}
        <a class="category-card" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: block.settings.title | escape }}
          {% else %}
            <img src="{{ 'retro-placeholder.svg' | asset_url }}" alt="" loading="lazy">
          {% endif %}
          <span class="category-card__overlay" aria-hidden="true"></span>
          <h3>{{ block.settings.title }}</h3>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Category CTAs",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Browse the good stuff" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Furniture" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category CTAs",
      "blocks": [
        { "type": "category", "settings": { "title": "Furniture", "link": "/collections/furniture" } },
        { "type": "category", "settings": { "title": "Glassware", "link": "/collections/glassware" } },
        { "type": "category", "settings": { "title": "Decor", "link": "/collections/decor" } },
        { "type": "category", "settings": { "title": "New finds", "link": "/collections/all" } }
      ]
    }
  ]
}
{% endschema %}
