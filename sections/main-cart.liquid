<section class="page-width cart-page">
  <div class="cart-page__heading">
    <div>
      <p class="cart-page__eyebrow">{{ 'cart.general.eyebrow' | t }}</p>
      <h1>{{ 'cart.general.title' | t }}</h1>
    </div>
    <a class="cart-page__continue" href="{{ routes.all_products_collection_url }}">{{ 'cart.general.continue_shopping' | t }}</a>
  </div>

  {% if cart.empty? %}
    <div class="cart-empty">
      <h2>{{ 'cart.general.empty' | t }}</h2>
      <p>{{ 'cart.general.empty_hint' | t }}</p>
      <a class="button" href="{{ routes.all_products_collection_url }}">{{ 'cart.general.browse' | t }}</a>
    </div>
  {% else %}
    <form action="{{ routes.cart_url }}" method="post" id="CartForm-{{ section.id }}" class="cart-layout">
      <div class="cart-items">
        <p class="cart-items__count">{{ 'cart.general.items_count' | t: count: cart.item_count }}</p>
        <ul class="cart-items__list" role="list">
          {% for item in cart.items %}
            <li class="cart-item">
              <a class="cart-item__image" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
                {% if item.image %}
                  {{ item.image | image_url: width: 320 | image_tag: loading: 'lazy', alt: item.product.title }}
                {% else %}
                  <img src="{{ 'retro-placeholder.svg' | asset_url }}" alt="" width="1200" height="900" loading="lazy">
                {% endif %}
              </a>
              <div class="cart-item__details">
                <a class="cart-item__title" href="{{ item.url }}">{{ item.product.title | escape }}</a>
                {% unless item.product.has_only_default_variant %}
                  <p>{{ item.variant.title | escape }}</p>
                {% endunless %}
                {% if item.selling_plan_allocation %}
                  <p>{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>
                {% endif %}
                {% for property in item.properties %}
                  {% assign property_first_character = property.first | slice: 0 %}
                  {% if property.last != blank and property_first_character != '_' %}
                    <p>{{ property.first | escape }}: {{ property.last | escape }}</p>
                  {% endif %}
                {% endfor %}
                <p class="cart-item__unit-price">{{ item.final_price | money }}</p>
                {% for discount in item.line_level_discount_allocations %}
                  <p class="cart-discount">{{ discount.discount_application.title | escape }} (−{{ discount.amount | money }})</p>
                {% endfor %}
                <a class="cart-item__remove" href="{{ item.url_to_remove }}" aria-label="{{ 'cart.general.remove_item' | t: title: item.product.title | escape }}">{{ 'cart.general.remove' | t }}</a>
              </div>
              <div class="cart-item__quantity">
                <label for="CartQuantity-{{ section.id }}-{{ forloop.index }}">{{ 'cart.general.quantity' | t }}</label>
                <input id="CartQuantity-{{ section.id }}-{{ forloop.index }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0" step="{{ item.variant.quantity_rule.increment }}" inputmode="numeric" aria-label="{{ 'cart.general.quantity_for' | t: title: item.product.title | escape }}" {% if item.variant.inventory_management and item.variant.inventory_policy == 'deny' %}max="{{ item.variant.inventory_quantity }}"{% endif %}>
              </div>
              <div class="cart-item__total">
                {% if item.original_line_price != item.final_line_price %}
                  <s>{{ item.original_line_price | money }}</s>
                {% endif %}
                <span>{{ item.final_line_price | money }}</span>
              </div>
            </li>
          {% endfor %}
        </ul>
        <button class="button button--secondary" type="submit" name="update">{{ 'cart.general.update' | t }}</button>
      </div>
      <aside class="cart-summary" aria-labelledby="CartSummary-{{ section.id }}">
        <h2 id="CartSummary-{{ section.id }}">{{ 'cart.general.summary' | t }}</h2>
        {% for discount in cart.cart_level_discount_applications %}
          <div class="cart-summary__row cart-discount">
            <span>{{ discount.title | escape }}</span>
            <span>−{{ discount.total_allocated_amount | money }}</span>
          </div>
        {% endfor %}
        <div class="cart-summary__row cart-summary__subtotal">
          <span>{{ 'cart.general.subtotal' | t }}</span>
          <strong>{{ cart.total_price | money_with_currency }}</strong>
        </div>
        <p class="cart-summary__hint">{{ 'cart.general.checkout_hint' | t }}</p>
        <label class="cart-summary__note-label" for="CartNote-{{ section.id }}">{{ 'cart.general.note' | t }}</label>
        <textarea id="CartNote-{{ section.id }}" name="note" rows="3">{{ cart.note | escape }}</textarea>
        <button class="button cart-summary__checkout" type="submit" name="checkout">{{ 'cart.general.checkout' | t }}</button>
        <p class="cart-summary__secure">{{ 'cart.general.secure' | t }}</p>
      </aside>
    </form>
  {% endif %}
</section>

{% stylesheet %}
  .cart-page { padding-block: 40px 72px; }
  .cart-page__heading { display: flex; align-items: end; justify-content: space-between; gap: 20px; margin-bottom: 28px; }
  .cart-page__eyebrow { margin: 0 0 4px; color: var(--rust); text-transform: uppercase; font-weight: 800; letter-spacing: .08em; font-size: .8rem; }
  .cart-page h1 { margin: 0; font: 800 clamp(2rem, 5vw, 3.2rem)/1.15 Georgia, serif; }
  .cart-page__continue, .cart-item__remove { text-decoration: underline; text-underline-offset: 4px; }
  .cart-layout { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: 28px; align-items: start; }
  .cart-items { padding: 24px; background: var(--cream); border: 2px solid var(--line); border-radius: 18px; }
  .cart-items__count { margin: 0 0 18px; font-weight: 700; }
  .cart-items__list { list-style: none; margin: 0 0 24px; padding: 0; }
  .cart-item { display: grid; grid-template-columns: 96px minmax(0, 1fr) 80px auto; align-items: start; gap: 18px; padding: 24px 0; border-top: 1px solid var(--line); }
  .cart-item__image { aspect-ratio: 1; overflow: hidden; border-radius: 10px; background: var(--paper); border: 1px solid var(--line); }
  .cart-item__image img { width: 100%; height: 100%; object-fit: cover; }
  .cart-item__title { font-weight: 800; line-height: 1.3; display: block; overflow-wrap: anywhere; }
  .cart-item__details p { margin: 6px 0; font-size: .88rem; }
  .cart-item__unit-price { color: var(--rust); font-weight: 800; }
  .cart-item__remove { display: inline-block; margin-top: 8px; font-size: .85rem; }
  .cart-item__quantity label { display: block; font-size: .8rem; margin-bottom: 6px; }
  .cart-item__quantity input { width: 100%; min-height: 44px; padding: 8px; border: 1px solid var(--ink); border-radius: 8px; color: var(--ink); background: var(--paper); }
  .cart-item__total { display: grid; text-align: right; font-weight: 800; padding-top: 26px; white-space: nowrap; }
  .cart-item__total s { font-size: .8rem; font-weight: 400; }
  .cart-discount { color: var(--rust); font-size: .85rem; }
  .cart-summary { padding: 26px; background: var(--cream); border: 2px solid var(--ink); border-radius: 18px; box-shadow: 5px 5px 0 var(--rust); }
  .cart-summary h2 { font: 800 1.6rem/1.2 Georgia, serif; margin: 0 0 24px; }
  .cart-summary__row { display: flex; justify-content: space-between; gap: 16px; margin-block: 12px; }
  .cart-summary__subtotal { padding-top: 18px; border-top: 1px solid var(--line); }
  .cart-summary__hint, .cart-summary__secure { font-size: .83rem; line-height: 1.5; }
  .cart-summary__note-label { display: block; margin: 22px 0 8px; font-size: .88rem; font-weight: 700; }
  .cart-summary textarea { width: 100%; padding: 10px; border: 1px solid var(--line); border-radius: 8px; background: var(--paper); color: var(--ink); resize: vertical; }
  .cart-summary__checkout { width: 100%; margin-top: 20px; }
  .cart-summary__secure { text-align: center; margin-bottom: 0; }
  .cart-empty { text-align: center; background: var(--cream); border: 2px solid var(--line); border-radius: 18px; padding: 60px 24px; }
  .cart-empty h2 { font: 800 1.8rem/1.2 Georgia, serif; margin-top: 0; }
  .cart-empty .button { margin-top: 18px; }
  @media (max-width: 960px) { .cart-layout { grid-template-columns: 1fr; } }
  @media (max-width: 600px) {
    .cart-page__heading { align-items: start; flex-direction: column; }
    .cart-items { padding: 18px; }
    .cart-item { grid-template-columns: 76px minmax(0, 1fr); gap: 14px; }
    .cart-item__quantity { grid-column: 2; width: 80px; }
    .cart-item__total { grid-column: 2; padding-top: 0; text-align: left; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Cart",
  "settings": []
}
{% endschema %}
